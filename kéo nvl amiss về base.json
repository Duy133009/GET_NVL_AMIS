    {
      "parameters": {
        "jsCode": "// Lấy toàn bộ dữ liệu từ các item trước\nconst data = items.map(item => item.json);\n\n// Nếu data là mảng → dùng luôn\n// Nếu không phải mảng → thử lấy ra key đầu tiên chứa mảng\nconst arr = Array.isArray(data)\n  ? data\n  : Object.values(data).find(v => Array.isArray(v)) || [data]; // fallback nếu chỉ có 1 object\n\n// Bắt đầu xử lý từng object\nconst result = arr.map(obj => {\n  const newObj = { ...obj };\n  \n  // Danh sách các field cần parse (vì chúng có thể chứa chuỗi JSON)\n  const jsonFields = ['unit_list', 'purchase_last_unit_price_list'];\n\n  jsonFields.forEach(field => {\n    const val = obj[field];\n    // Nếu là string thì thử parse, nếu không thì giữ nguyên\n    if (typeof val === 'string') {\n      try {\n        newObj[field] = JSON.parse(val);\n      } catch (e) {\n        newObj[field] = val; // giữ nguyên nếu lỗi parse\n      }\n    } else {\n      newObj[field] = val; // giữ nguyên object\n    }\n  });\n\n  return newObj;\n});\n\n// Trả kết quả cho n8n\nreturn result.map(r => ({ json: r }));\n"
      },
