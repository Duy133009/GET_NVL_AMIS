    {
      "parameters": {
        "jsCode": "const inventoryItemCode = $input.first().json.inventory_item_code;\nconst accessToken = $input.first().json.tenant_access_token;\n\nreturn [{\n  json: {\n    accessToken,\n    inventoryItemCode,\n    requestBody: {\n      filter: {\n        conjunction: \"and\",\n        conditions: [{\n          field_name: \"Ma_NVL\",\n          operator: \"is\",\n          value: [inventoryItemCode]\n        }]\n      },\n      automatic_fields: false\n    }\n  }\n}];"
      },
